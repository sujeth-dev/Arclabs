# Production origin (canonical URLs, sitemap, OG image URLs). No trailing slash.
SITE_URL=https://arclabs.vercel.app

# Formspree form ID for the Contact form (https://formspree.io → New form → ID like "xyzabcd").
# Without it, the form falls back to opening the visitor's email app.
PUBLIC_FORMSPREE_ID=

# Plausible site domain (e.g. arclabs.tech). Without it, analytics events are no-ops.
PUBLIC_PLAUSIBLE_DOMAIN=
