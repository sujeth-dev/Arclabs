{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Static site: nothing to install'",
  "buildCommand": "echo 'Static site: no build step'",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    { "source": "/elements", "destination": "/services/", "permanent": true },
    { "source": "/elements/", "destination": "/services/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.arclabs.live" }], "destination": "https://arclabs.live/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "arclabs.vercel.app" }], "destination": "https://arclabs.live/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/(assets|media)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(css|js|data)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
